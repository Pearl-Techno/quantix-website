# ====================================================================
# QUANTYX LABS — APACHE WEB SERVER CONFIGURATION & SECURITY
# ====================================================================

RewriteEngine On

# Prevent directory browsing
Options -Indexes -MultiViews

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect hidden files and directories (starting with .)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Allow static files and existing directories to pass through directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URL rewriting: map clean paths to .php files
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

# Error Documents fallback
ErrorDocument 404 /index.php
